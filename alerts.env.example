# Copy this file to "alerts.env" (same folder) and fill in ONE of the options.
# alerts.env stays on your computer and is never uploaded.

# Option A: CallMeBot (free, takes 2 minutes)
# 1. Go to callmebot.com, open the WhatsApp page, and save their bot's number in your phone contacts
# 2. Send it the WhatsApp message they show ("I allow callmebot to send me messages")
# 3. It replies with your API key. Put your number (with country code, e.g. +447700900123) and the key below.
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=

# Option B: Twilio WhatsApp (more reliable, small cost per message after free trial)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+14155238886
TWILIO_WHATSAPP_TO=

# Optional: free OpenFIGI key makes the first run much faster (openfigi.com/api)
OPENFIGI_API_KEY=

# Optional: the SEC asks for a contact in the User-Agent. A generic one is used by default.
# SEC_USER_AGENT=HedgeFundTracker/1.0 your-email@example.com
